# Static file server for the built SPA (inside the gomoku-web container).
{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		# Hashed bundles never change: cache for a year.  Everything else
		# (index.html, version.json, manifest) is revalidated on every load,
		# so a new release is picked up immediately.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header -Last-Modified
		@other not path /assets/*
		header @other Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
